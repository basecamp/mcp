      "expect": {"writes": ["^POST /projects/1/todos\\.json .*\"title\":\"(?i:book the venue)\""]},
      "script": [
        {"tool": "fake_projects", "arguments": {"action": "list_projects"}},
        {"tool": "fake_todos", "arguments": {"action": "create_todo", "params": {"project_id": 1, "title": "Book the venue"}}}
