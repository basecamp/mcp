      "reject": {"writes": ["^POST /todos/(?:1[02-9]|[0-9]{3,})/completion"]},
      "script": [
        {"tool": "fake_projects", "arguments": {"action": "list_projects"}},
        {"tool": "fake_todos", "arguments": {"action": "list_todos", "params": {"project_id": 1}}},
        {"tool": "fake_todos", "arguments": {"action": "complete_todo", "params": {"todo_id": 11}}}
