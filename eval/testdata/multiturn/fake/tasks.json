      "script": [
        {"tool": "fake_projects", "arguments": {"action": "list_projects"}},
        {"tool": "fake_todos", "arguments": {"action": "list_todos", "params": {"project_id": 1}}}
      ],
      "script_answer": "Two open todos: Write launch notes, and Old draft of the press release."
    },
    {
